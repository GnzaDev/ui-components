{
  "name": "@gonza/ui-components",
  "version": "1.0.0",
  "description": "Standalone UI components: GonzaModal (Motion spring morphing), DavoModal (GSAP Flip dialog), and SideSheet drawer.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./*": "./dist/*"
  },
  "author": "Gonzalo",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "tsc --noEmit && vite build --config vite.config.lib.ts",
    "build:app": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "vite build --config vite.config.lib.ts",
    "prepare": "vite build --config vite.config.lib.ts"
  },
  "peerDependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "lucide-react": "^0.470.0",
    "motion": "^11.18.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.470.0",
    "motion": "^11.18.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  }
}
